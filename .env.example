# Neon database connection string
# Get this from: https://console.neon.tech → your project → Connection Details
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# --- Knuut realtime voice (OpenAI only; WebRTC) ---
# OPENAI_API_KEY=sk-proj-...
# OPENAI_REALTIME_MODEL=gpt-realtime-1.5
# OPENAI_REALTIME_VOICE=verse
#
# Optional tuning (noisy rooms / breath pickup):
# REALTIME_INPUT_NOISE_REDUCTION=far_field   # near_field | off — try off if audio breaks up / stalls
# REALTIME_VAD_THRESHOLD=0.78
# REALTIME_VAD_SILENCE_MS=850
# REALTIME_VAD_PREFIX_MS=240
# REALTIME_VAD_MODE=server                  # or semantic
# REALTIME_VAD_EAGERNESS=low
# REALTIME_TEMPERATURE=0.75

# --- Optional: Azure OpenAI for chat / embeddings (NOT used for realtime voice in this project) ---
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o
# AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
# AZURE_OPENAI_API_VERSION=2025-01-01-preview

# OpenRouter keys — for non-realtime tasks (summaries, analysis, etc.) to save OpenAI usage
# Get from: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_API_KEY_2=sk-or-v1-...

# JWT auth — MUST match between login server and API (set the same on Vercel). Default in code is dev-secret-change-in-production if unset.
JWT_SECRET=dev-secret-change-in-production

# CORS — comma-separated origins (optional; default includes localhost + suvisbrain.vercel.app)
# ALLOWED_ORIGINS=https://yourapp.com,https://www.yourapp.com

# Resend — weekly emails (get from resend.com)
RESEND_API_KEY=re_...
RESEND_FROM=Knuut <onboarding@resend.dev>

# Cron — secret to protect /api/cron-weekly (Vercel sets this for cron)
CRON_SECRET=optional-cron-secret

# Knuut voice — max seconds per learner per calendar day (Europe/Helsinki). Unused time does not roll over.
# VOICE_DAILY_CAP_SECONDS=1800
# Set to 1 to disable enforcement (not recommended in production)
# VOICE_DAILY_QUOTA_DISABLED=0
