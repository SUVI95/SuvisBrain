# Neon database connection string
# Get this from: https://console.neon.tech → your project → Connection Details
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# --- Knuut voice (pick ONE path) ---
# A) Azure OpenAI (EU / Foundry) — preferred when configured (see also docs on client_secrets + WebRTC)
#    Resource endpoint (no trailing slash), key from Azure portal, deployment name = your realtime model deployment
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_API_KEY=
# Leave empty until realtime is deployed — Knuut voice then uses OPENAI_API_KEY below
AZURE_OPENAI_REALTIME_DEPLOYMENT=
# Optional: Azure chat + embeddings (same resource/key). API version for deployments/chat/embeddings (default 2025-01-01-preview)
# AZURE_OPENAI_API_VERSION=2025-01-01-preview
# AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o
# AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
# Azure WebRTC: webrtcfilter=on is DEFAULT on /realtime/calls (disable with AZURE_OPENAI_WEBRTC_FILTER=0)
# If client_secrets rejects session JSON, try AZURE_OPENAI_REALTIME_MINIMAL_AUDIO=1 (output voice only)
# AZURE_OPENAI_WEBRTC_FILTER=0
# AZURE_OPENAI_REALTIME_MINIMAL_AUDIO=1

# B) OpenAI public API (legacy) — realtime voice; also used by src/lib/embeddings.js if set
# OPENAI_API_KEY=sk-proj-...

# OpenRouter keys — for non-realtime tasks (summaries, analysis, etc.) to save OpenAI usage
# Get from: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_API_KEY_2=sk-or-v1-...

# JWT auth — MUST match between login server and API (set the same on Vercel). Default in code is dev-secret-change-in-production if unset.
JWT_SECRET=dev-secret-change-in-production

# CORS — comma-separated origins (optional; default includes localhost + suvisbrain.vercel.app)
# ALLOWED_ORIGINS=https://yourapp.com,https://www.yourapp.com

# Resend — weekly emails (get from resend.com)
RESEND_API_KEY=re_...
RESEND_FROM=Knuut <onboarding@resend.dev>

# Cron — secret to protect /api/cron-weekly (Vercel sets this for cron)
CRON_SECRET=optional-cron-secret

# Knuut voice — max seconds per learner per calendar day (Europe/Helsinki). Unused time does not roll over.
# VOICE_DAILY_CAP_SECONDS=1800
# Set to 1 to disable enforcement (not recommended in production)
# VOICE_DAILY_QUOTA_DISABLED=0
